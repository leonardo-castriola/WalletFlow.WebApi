@page "/criar-conta"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using WalletFlow.Infrastructure.Persistence
@inject UserManager<WalletUser> UserManager

<PageTitle>Criar conta | WalletFlow</PageTitle>

<section class="identity-page" aria-labelledby="register-title">
    <div class="identity-card">
        <a class="identity-brand" href="/" aria-label="WalletFlow — página inicial">
            <span class="identity-brand-mark" aria-hidden="true">W</span>
            <span>WalletFlow</span>
        </a>

        <header class="identity-heading">
            <p class="eyebrow">COMECE A ORGANIZAR</p>
            <h1 id="register-title">Criar sua conta</h1>
            <p class="identity-intro">Use seu e-mail para criar um espaço financeiro privado.</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="identity-notice" role="status">@_message</div>
        }
        @if (_errors.Count > 0)
        {
            <div class="identity-error" role="alert"><ul>@foreach (var error in _errors) { <li>@error</li> }</ul></div>
        }

        @if (!_completed)
        {
            <EditForm Model="_model!" FormName="register" OnValidSubmit="RegisterAsync" Enhance class="identity-form">
                <DataAnnotationsValidator />
                <div class="identity-field">
                    <label for="register-name">Nome completo</label>
                    <InputText id="register-name" class="identity-input" autocomplete="name" maxlength="120" @bind-Value="_model!.NomeCompleto" />
                    <ValidationMessage For="@(() => _model!.NomeCompleto)" />
                </div>
                <div class="identity-field">
                    <label for="register-email">E-mail</label>
                    <InputText id="register-email" class="identity-input" type="email" autocomplete="email" @bind-Value="_model!.Email" />
                    <ValidationMessage For="@(() => _model!.Email)" />
                </div>
                <div class="identity-field">
                    <label for="register-phone">Telefone</label>
                    <InputText id="register-phone" class="identity-input" type="tel" autocomplete="tel" placeholder="(21) 99999-9999" @bind-Value="_model!.Telefone" />
                    <ValidationMessage For="@(() => _model!.Telefone)" />
                </div>
                <div class="identity-field">
                    <label for="register-cpf">CPF</label>
                    <InputText id="register-cpf" class="identity-input" autocomplete="off" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" @bind-Value="_model!.Cpf" />
                    <ValidationMessage For="@(() => _model!.Cpf)" />
                </div>

                <p class="identity-section-title">Endereço completo</p>
                <div class="identity-address-grid">
                    <div class="identity-field"><label for="register-cep">CEP</label><InputText id="register-cep" class="identity-input" autocomplete="postal-code" inputmode="numeric" maxlength="9" placeholder="00000-000" @bind-Value="_model!.Cep" /><ValidationMessage For="@(() => _model!.Cep)" /><small id="register-cep-status" role="status" aria-live="polite" class="form-text">Digite o CEP para preencher o endereço automaticamente.</small></div>
                    <div class="identity-field"><label for="register-state">Estado (UF)</label><InputText id="register-state" class="identity-input" autocomplete="address-level1" maxlength="2" placeholder="RJ" @bind-Value="_model!.Estado" /><ValidationMessage For="@(() => _model!.Estado)" /></div>
                    <div class="identity-field full-width"><label for="register-street">Logradouro</label><InputText id="register-street" class="identity-input" autocomplete="address-line1" maxlength="160" placeholder="Rua, avenida..." @bind-Value="_model!.Logradouro" /><ValidationMessage For="@(() => _model!.Logradouro)" /></div>
                    <div class="identity-field"><label for="register-number">Número</label><InputText id="register-number" class="identity-input" autocomplete="off" maxlength="30" @bind-Value="_model!.Numero" /><ValidationMessage For="@(() => _model!.Numero)" /></div>
                    <div class="identity-field"><label for="register-complement">Complemento <span>(opcional)</span></label><InputText id="register-complement" class="identity-input" autocomplete="address-line2" maxlength="100" @bind-Value="_model!.Complemento" /></div>
                    <div class="identity-field"><label for="register-neighborhood">Bairro</label><InputText id="register-neighborhood" class="identity-input" autocomplete="address-level3" maxlength="100" @bind-Value="_model!.Bairro" /><ValidationMessage For="@(() => _model!.Bairro)" /></div>
                    <div class="identity-field"><label for="register-city">Cidade</label><InputText id="register-city" class="identity-input" autocomplete="address-level2" maxlength="100" @bind-Value="_model!.Cidade" /><ValidationMessage For="@(() => _model!.Cidade)" /></div>
                </div>
                <div class="identity-field">
                    <label for="register-password">Senha</label>
                    <div class="identity-password-wrap">
                        <InputText id="register-password" class="identity-input" type="password" autocomplete="new-password" @bind-Value="_model!.Password" />
                        <button class="identity-password-toggle" type="button" data-password-toggle aria-controls="register-password" aria-label="Mostrar senha" aria-pressed="false">
                            <svg class="password-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12s3.45-6 9.5-6 9.5 6 9.5 6-3.45 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.7" stroke="currentColor" stroke-width="1.7"/></svg>
                            <svg class="password-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.05 0 9.5 7 9.5 7a15 15 0 0 1-3.1 3.9M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.45 7 9.5 7c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _model!.Password)" />
                    <small>Use 12 ou mais caracteres, com maiúscula, minúscula, número e símbolo.</small>
                </div>
                <div class="identity-field">
                    <label for="register-confirm-password">Confirmar senha</label>
                    <div class="identity-password-wrap">
                        <InputText id="register-confirm-password" class="identity-input" type="password" autocomplete="new-password" @bind-Value="_model!.ConfirmPassword" />
                        <button class="identity-password-toggle" type="button" data-password-toggle aria-controls="register-confirm-password" aria-label="Mostrar senha" aria-pressed="false">
                            <svg class="password-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12s3.45-6 9.5-6 9.5 6 9.5 6-3.45 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.7" stroke="currentColor" stroke-width="1.7"/></svg>
                            <svg class="password-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.05 0 9.5 7 9.5 7a15 15 0 0 1-3.1 3.9M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.45 7 9.5 7c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _model!.ConfirmPassword)" />
                </div>
                <button class="identity-submit" type="submit">Cadastrar novo usuário</button>
            </EditForm>
        }

        <p class="identity-footer">Já tem uma conta? <a href="/">Voltar para entrar</a></p>
        <p class="identity-security-note"><span aria-hidden="true">●</span> Seus dados são tratados com segurança.</p>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "register")]
    private RegisterModel? _model { get; set; }
    private readonly List<string> _errors = [];
    private string? _message;
    private bool _completed;

    protected override void OnInitialized() => _model ??= new();

    private async Task RegisterAsync()
    {
        _errors.Clear();
        var model = _model!;
        var user = new WalletUser
        {
            UserName = model.Email.Trim(),
            Email = model.Email.Trim(),
            EmailConfirmed = true,
            NomeCompleto = model.NomeCompleto.Trim(),
            PhoneNumber = model.Telefone.Trim(),
            Cpf = SomenteDigitos(model.Cpf),
            EnderecoCep = SomenteDigitos(model.Cep),
            EnderecoLogradouro = model.Logradouro.Trim(),
            EnderecoNumero = model.Numero.Trim(),
            EnderecoComplemento = string.IsNullOrWhiteSpace(model.Complemento) ? null : model.Complemento.Trim(),
            EnderecoBairro = model.Bairro.Trim(),
            EnderecoCidade = model.Cidade.Trim(),
            EnderecoEstado = model.Estado.Trim().ToUpperInvariant()
        };
        var result = await UserManager.CreateAsync(user, model.Password);
        if (!result.Succeeded)
        {
            if (result.Errors.Any(error => error.Code is "DuplicateEmail" or "DuplicateUserName"))
            {
                _message = "Este e-mail já está cadastrado. Entre na sua conta ou recupere sua senha.";
                return;
            }

            _errors.AddRange(result.Errors.Select(error => error.Description));
            return;
        }

        _completed = true;
        _message = "Usuário cadastrado com sucesso.";
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Informe seu nome completo.")]
        [StringLength(120, ErrorMessage = "O nome deve ter até 120 caracteres.")]
        public string NomeCompleto { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um endereço de e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu telefone.")]
        [Phone(ErrorMessage = "Informe um telefone válido com DDD.")]
        public string Telefone { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu CPF.")]
        [CpfValido(ErrorMessage = "Informe um CPF válido.")]
        public string Cpf { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu CEP.")]
        [RegularExpression(@"^\d{5}-?\d{3}$", ErrorMessage = "Informe um CEP válido.")]
        public string Cep { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o logradouro.")]
        [StringLength(160)]
        public string Logradouro { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o número do endereço.")]
        [StringLength(30)]
        public string Numero { get; set; } = string.Empty;

        [StringLength(100)]
        public string? Complemento { get; set; }

        [Required(ErrorMessage = "Informe o bairro.")]
        [StringLength(100)]
        public string Bairro { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a cidade.")]
        [StringLength(100)]
        public string Cidade { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a UF.")]
        [RegularExpression(@"^[A-Za-z]{2}$", ErrorMessage = "Informe a sigla de dois caracteres do estado.")]
        public string Estado { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe uma senha.")]
        [MinLength(12, ErrorMessage = "A senha deve ter pelo menos 12 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme sua senha.")]
        [Compare(nameof(Password), ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private static string SomenteDigitos(string valor) => new(valor.Where(char.IsDigit).ToArray());
}
