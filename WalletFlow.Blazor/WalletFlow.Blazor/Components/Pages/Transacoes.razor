@page "/transacoes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using WalletFlow.Blazor.DTOs
@using WalletFlow.Blazor.Enums
@using WalletFlow.Blazor.Services
@using WalletFlow.Application.Abstractions
@using WalletFlow.Infrastructure.Persistence
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject TransacaoApiClient Api
@inject NavigationManager Navigation
@inject UserManager<WalletUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject WalletFlow.Application.Abstractions.IEmailSender EmailSender
@inject ILogger<Transacoes> Logger

<PageTitle>Extrato | WalletFlow</PageTitle>

<div class="dashboard-header">
    <div>
        <p class="eyebrow">HISTÓRICO FINANCEIRO</p>
        <h1>Extrato</h1>
        <p class="text-secondary">Pesquise e navegue pelas receitas e despesas.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-primary" @onclick='() => Navigation.NavigateTo("/transacoes/importar")'>⇧ Importar extrato</button>
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/transacoes/nova")'>＋ Nova transação</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_erro))
{
    <div class="alert alert-danger" role="alert">@_erro</div>
    @if (_erro.StartsWith("Complete seu cadastro", StringComparison.Ordinal))
    {
        <p><a class="btn btn-outline-primary mb-3" href="/meu-cadastro">Completar meu cadastro</a></p>
    }
}
@if (!string.IsNullOrWhiteSpace(_mensagem))
{
    <div class="alert alert-success" role="status">@_mensagem</div>
}

<section class="panel transactions-panel">
    <div class="section-heading">
        <div><p class="eyebrow">MOVIMENTAÇÕES</p><h2>Transações</h2></div>
        @if (_resultado is not null) { <span class="result-count">@_resultado.TotalCount registro(s)</span> }
    </div>

    <form class="filters" @onsubmit="AplicarFiltrosAsync" @onsubmit:preventDefault>
        <div>
            <label class="form-label" for="filtro-tipo">Tipo</label>
            <select id="filtro-tipo" class="form-select" @bind="_tipoFiltro">
                <option value="">Todos</option><option value="0">Despesas</option><option value="1">Receitas</option>
            </select>
        </div>
        <div><label class="form-label" for="data-inicio">De</label><input id="data-inicio" class="form-control" type="date" value="@_dataInicio" @onchange="e => _dataInicio = e.Value?.ToString() ?? string.Empty" /></div>
        <div><label class="form-label" for="data-fim">Até</label><input id="data-fim" class="form-control" type="date" value="@_dataFim" @onchange="e => _dataFim = e.Value?.ToString() ?? string.Empty" /></div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-primary" disabled="@_carregando">Filtrar</button>
            <button type="button" class="btn btn-link" @onclick="LimparFiltrosAsync">Limpar</button>
            <button type="button" class="btn btn-outline-primary" @onclick="EnviarExtratoPorEmailAsync" disabled="@(_carregando || _enviandoEmail)">
                @(_enviandoEmail ? "Enviando..." : "✉ Enviar para meu e-mail")
            </button>
        </div>
    </form>
    <p class="statement-email-note">O extrato do período selecionado será enviado para o e-mail da sua conta.</p>

    @if (_carregando)
    {
        <p class="empty-state" role="status">Carregando transações...</p>
    }
    else if (_resultado is null || _resultado.Items.Count == 0)
    {
        <p class="empty-state">Nenhuma transação encontrada para estes filtros.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table transaction-table align-middle">
                <thead><tr><th>Descrição</th><th>Data</th><th>Tipo</th><th class="text-end">Valor</th><th class="text-end">Ações</th></tr></thead>
                <tbody>
                    @foreach (var transacao in _resultado.Items)
                    {
                        <tr>
                            <td class="transaction-description">@transacao.Descricao</td>
                            <td>@Api.ConverterParaFusoConfigurado(transacao.DataCadastro).ToString("dd/MM/yyyy", Cultura)</td>
                            <td><span class="type-pill @(transacao.TipoFormatado == "Receita" ? "income" : "expense")">@transacao.TipoFormatado</span></td>
                            <td class="text-end transaction-value">@transacao.Valor.ToString("C", Cultura)</td>
                            <td class="text-end transaction-actions">
                                @if (_exclusaoPendenteId == transacao.Id)
                                {
                                    <span class="delete-confirmation">Excluir esta transação?</span>
                                    <button class="btn btn-sm btn-danger" @onclick="() => ExcluirAsync(transacao.Id)" disabled="@_excluindo">@( _excluindo ? "Excluindo..." : "Confirmar")</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelarExclusao" disabled="@_excluindo">Cancelar</button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"/transacoes/editar/{transacao.Id}")" aria-label="Editar transação: @transacao.Descricao">Editar</a>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => SolicitarExclusao(transacao.Id)" aria-label="Excluir transação: @transacao.Descricao">Excluir</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-row">
            <span>Página @_resultado.Page de @_resultado.TotalPages</span>
            <div class="btn-group" role="group" aria-label="Paginação do extrato">
                <button class="btn btn-outline-secondary" @onclick="PaginaAnteriorAsync" disabled="@(_pagina <= 1 || _carregando)">Anterior</button>
                <button class="btn btn-outline-secondary" @onclick="ProximaPaginaAsync" disabled="@(_pagina >= _resultado.TotalPages || _carregando)">Próxima</button>
            </div>
        </div>
    }
</section>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private ResultadoPaginadoDto<TransacaoRespostaDto>? _resultado;
    private string _tipoFiltro = string.Empty;
    private string _dataInicio = string.Empty;
    private string _dataFim = string.Empty;
    private string? _erro;
    private string? _mensagem;
    private bool _carregando = true;
    private bool _excluindo;
    private bool _enviandoEmail;
    private int? _exclusaoPendenteId;
    private int _pagina = 1;
    private const int ItensPorPagina = 10;

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = null;
        try
        {
            var inicio = LerData(_dataInicio, "inicial");
            var fim = LerData(_dataFim, "final");
            if (inicio.HasValue && fim.HasValue && inicio.Value > fim.Value)
                throw new InvalidOperationException("A data inicial deve ser anterior ou igual à data final.");

            var resultado = await Api.ObterTransacoesAsync(_pagina, ItensPorPagina, LerTipoFiltro(), inicio, fim);
            _resultado = resultado;
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.StatusCode is null
                ? "Não foi possível conectar à API. Confira se ela está em execução e se Api:BaseUrl está correto."
                : ex.Message;
        }
        catch (InvalidOperationException ex) when (
            ex.Message.StartsWith("Informe uma data", StringComparison.Ordinal) ||
            ex.Message.StartsWith("A data inicial", StringComparison.Ordinal) ||
            ex.Message.StartsWith("Selecione ao menos uma data", StringComparison.Ordinal) ||
            ex.Message.StartsWith("Selecione um tipo", StringComparison.Ordinal))
        {
            _erro = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogError(ex, "Configuração inválida ao enviar o extrato por e-mail.");
            _erro = "Não foi possível enviar o extrato por e-mail. Verifique a configuração do serviço de e-mail e tente novamente.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task AplicarFiltrosAsync() { _pagina = 1; await CarregarAsync(); }
    private async Task LimparFiltrosAsync() { _tipoFiltro = _dataInicio = _dataFim = string.Empty; _pagina = 1; await CarregarAsync(); }
    private async Task PaginaAnteriorAsync() { if (_pagina > 1) { _pagina--; await CarregarAsync(); } }
    private async Task ProximaPaginaAsync() { if (_resultado is not null && _pagina < _resultado.TotalPages) { _pagina++; await CarregarAsync(); } }

    private async Task EnviarExtratoPorEmailAsync()
    {
        if (_enviandoEmail || _carregando)
            return;

        _erro = null;
        _mensagem = null;
        _enviandoEmail = true;

        try
        {
            var inicio = LerData(_dataInicio, "inicial");
            var fim = LerData(_dataFim, "final");
            if (!inicio.HasValue && !fim.HasValue)
                throw new InvalidOperationException("Selecione ao menos uma data para definir o período do extrato.");
            if (inicio.HasValue && fim.HasValue && inicio.Value > fim.Value)
                throw new InvalidOperationException("A data inicial deve ser anterior ou igual à data final.");

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (string.IsNullOrWhiteSpace(user?.Email))
                throw new UnauthorizedAccessException("Não foi possível identificar o e-mail da sua conta. Entre novamente.");
            if (string.IsNullOrWhiteSpace(user.NomeCompleto) || string.IsNullOrWhiteSpace(user.Cpf)
                || string.IsNullOrWhiteSpace(user.PhoneNumber) || string.IsNullOrWhiteSpace(user.EnderecoCep)
                || string.IsNullOrWhiteSpace(user.EnderecoLogradouro) || string.IsNullOrWhiteSpace(user.EnderecoNumero)
                || string.IsNullOrWhiteSpace(user.EnderecoBairro) || string.IsNullOrWhiteSpace(user.EnderecoCidade)
                || string.IsNullOrWhiteSpace(user.EnderecoEstado))
                throw new InvalidOperationException("Complete seu cadastro com nome, telefone, CPF e endereço completo antes de solicitar o relatório.");

            var tipo = LerTipoFiltro();
            var transacoes = await Api.ObterTodasTransacoesAsync(tipo, inicio, fim);
            var periodo = $"{inicio?.ToString("dd/MM/yyyy", Cultura) ?? "início"} a {fim?.ToString("dd/MM/yyyy", Cultura) ?? "hoje"}";
            var tipoSelecionado = tipo?.ToString() ?? "Todos";
            var pdf = ExtratoPdfGenerator.Gerar(transacoes, user, periodo, tipoSelecionado, Api.ConverterParaFusoConfigurado);
            var html = MontarMensagemExtratoHtml(transacoes, periodo, tipoSelecionado);
            var nomeArquivo = $"walletflow-extrato-{DateTime.Now:yyyy-MM-dd}.pdf";
            await EmailSender.SendAsync(
                user.Email,
                $"Seu extrato WalletFlow — {periodo}",
                html,
                [new EmailAttachment(nomeArquivo, "application/pdf", pdf)]);

            _mensagem = $"Extrato do período enviado para {user.Email}, com o PDF anexado.";
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.StatusCode is null
                ? "Não foi possível conectar à API. Confira se ela está em execução e se Api:BaseUrl está correto."
                : ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            _erro = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            _erro = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao enviar o extrato do período para o e-mail da conta autenticada.");
            _erro = "Não foi possível enviar o extrato por e-mail. Verifique a configuração do serviço de e-mail e tente novamente.";
        }
        finally
        {
            _enviandoEmail = false;
        }
    }

    private static string MontarMensagemExtratoHtml(
        IReadOnlyList<TransacaoRespostaDto> transacoes,
        string periodo,
        string tipo)
    {
        var receitas = transacoes.Where(item => item.TipoFormatado == "Receita").Sum(item => item.Valor);
        var despesas = transacoes.Where(item => item.TipoFormatado == "Despesa").Sum(item => item.Valor);
        return $"""
            <div style="font-family:Arial,sans-serif;color:#172b4d;max-width:600px;margin:auto">
              <h2>Seu extrato WalletFlow está pronto</h2>
              <p>Período: <strong>{System.Net.WebUtility.HtmlEncode(periodo)}</strong> · Tipo: <strong>{System.Net.WebUtility.HtmlEncode(tipo)}</strong></p>
              <p>Receitas: <strong>{receitas.ToString("C", Cultura)}</strong><br />Despesas: <strong>{despesas.ToString("C", Cultura)}</strong><br />Saldo do período: <strong>{(receitas - despesas).ToString("C", Cultura)}</strong></p>
              <p>O extrato completo, com todos os lançamentos e totais, está anexado em PDF.</p>
              <p style="color:#64748b;font-size:12px">Mensagem enviada pelo WalletFlow para o e-mail da sua conta.</p>
            </div>
            """;
    }

    private void SolicitarExclusao(int id)
    {
        _exclusaoPendenteId = id;
        _erro = null;
        _mensagem = null;
    }

    private void CancelarExclusao() => _exclusaoPendenteId = null;

    private async Task ExcluirAsync(int id)
    {
        if (_excluindo || _exclusaoPendenteId != id)
            return;

        _excluindo = true;
        _erro = null;
        _mensagem = null;
        try
        {
            await Api.ExcluirTransacaoAsync(id);
            _exclusaoPendenteId = null;
            _mensagem = "Transação excluída com sucesso.";

            if (_resultado?.Items.Count == 1 && _pagina > 1)
                _pagina--;

            await CarregarAsync();
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.StatusCode is null
                ? "Não foi possível conectar à API. Confira se ela está em execução e se Api:BaseUrl está correto."
                : ex.Message;
        }
        finally
        {
            _excluindo = false;
        }
    }

    private TipoTransacao? LerTipoFiltro()
    {
        if (string.IsNullOrWhiteSpace(_tipoFiltro)) return null;
        if (int.TryParse(_tipoFiltro, out var valor) && Enum.IsDefined(typeof(TipoTransacao), valor)) return (TipoTransacao)valor;
        throw new InvalidOperationException("Selecione um tipo de transação válido.");
    }

    private static DateOnly? LerData(string valor, string nome)
    {
        if (string.IsNullOrWhiteSpace(valor)) return null;
        if (DateOnly.TryParseExact(valor, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var data)) return data;
        throw new InvalidOperationException($"Informe uma data {nome} válida.");
    }
}
