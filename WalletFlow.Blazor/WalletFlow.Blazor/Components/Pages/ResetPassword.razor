@page "/redefinir-senha"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using WalletFlow.WebApi.Entities
@using WalletFlow.WebApi.Services
@inject UserManager<WalletUser> UserManager
@inject IEmailSender EmailSender
@inject ILogger<ResetPassword> Logger

<PageTitle>Redefinir senha | WalletFlow</PageTitle>

<section class="identity-page" aria-labelledby="reset-password-title">
    <div class="identity-card">
        <a class="identity-brand" href="/" aria-label="WalletFlow — página inicial">
            <span class="identity-brand-mark" aria-hidden="true">W</span>
            <span>WalletFlow</span>
        </a>

        <header class="identity-heading">
            <p class="eyebrow">SEGURANÇA DA CONTA</p>
            <h1 id="reset-password-title">Defina uma nova senha</h1>
            <p class="identity-intro">Escolha uma senha nova e segura para voltar a acessar sua conta.</p>
        </header>

        @if (_success)
        {
            <div class="identity-notice" role="status">@_message</div>
            @if (_emailNotificationFailed)
            {
                <div class="identity-error" role="status">A senha foi alterada, mas não foi possível enviar o aviso por e-mail.</div>
            }
            <a class="identity-submit identity-submit-link" href="/">Ir para a página de login</a>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="identity-error" role="alert">@_message</div>
            }
            @if (!_tokenInvalid)
            {
                <EditForm Model="_model!" FormName="reset-password" OnValidSubmit="ResetAsync" OnInvalidSubmit="OnInvalidReset" Enhance class="identity-form">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <InputText type="hidden" @bind-Value="_model!.UserId" />
                    <InputText type="hidden" @bind-Value="_model!.Token" />
                    <div class="identity-field">
                        <label for="reset-email">E-mail</label>
                        <InputText id="reset-email" class="identity-input" type="email" autocomplete="email" @bind-Value="_model!.Email" />
                        <ValidationMessage For="@(() => _model!.Email)" />
                    </div>
                    <div class="identity-field">
                        <label for="reset-password">Nova senha</label>
                        <div class="identity-password-wrap">
                            <InputText id="reset-password" class="identity-input" type="password" autocomplete="new-password" @bind-Value="_model!.Password" />
                            <button class="identity-password-toggle" type="button" data-password-toggle aria-controls="reset-password" aria-label="Mostrar senha" aria-pressed="false">
                                <svg class="password-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12s3.45-6 9.5-6 9.5 6 9.5 6-3.45 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.7" stroke="currentColor" stroke-width="1.7"/></svg>
                                <svg class="password-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.05 0 9.5 7 9.5 7a15 15 0 0 1-3.1 3.9M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.45 7 9.5 7c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _model!.Password)" />
                        <small>Use pelo menos 12 caracteres, com letra maiúscula, letra minúscula, número e símbolo.</small>
                    </div>
                    <div class="identity-field">
                        <label for="reset-confirm-password">Confirmar nova senha</label>
                        <div class="identity-password-wrap">
                            <InputText id="reset-confirm-password" class="identity-input" type="password" autocomplete="new-password" @bind-Value="_model!.ConfirmPassword" />
                            <button class="identity-password-toggle" type="button" data-password-toggle aria-controls="reset-confirm-password" aria-label="Mostrar senha" aria-pressed="false">
                                <svg class="password-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12s3.45-6 9.5-6 9.5 6 9.5 6-3.45 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.7" stroke="currentColor" stroke-width="1.7"/></svg>
                                <svg class="password-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.05 0 9.5 7 9.5 7a15 15 0 0 1-3.1 3.9M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.45 7 9.5 7c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _model!.ConfirmPassword)" />
                    </div>
                    <button class="identity-submit" type="submit">Salvar nova senha</button>
                </EditForm>
            }
        }
        <p class="identity-footer"><a href="/">Voltar para entrar</a></p>
        <p class="identity-security-note"><span aria-hidden="true">●</span> Seus dados são tratados com segurança.</p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? QueryUserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? QueryToken { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordModel? _model { get; set; }
    private string? _message;
    private bool _success;
    private bool _emailNotificationFailed;
    private bool _tokenInvalid;

    protected override void OnInitialized()
    {
        _model ??= new() { UserId = QueryUserId ?? string.Empty, Token = QueryToken ?? string.Empty };
    }

    private void OnInvalidReset(EditContext editContext)
    {
        var validationMessages = editContext.GetValidationMessages().ToArray();
        Logger.LogWarning(
            "O formulário de redefinição foi enviado com campos inválidos: {ValidationMessages}",
            string.Join(" | ", validationMessages));
        _message = "Revise os campos destacados e corrija os dados antes de salvar a nova senha.";
    }

    private async Task ResetAsync()
    {
        try
        {
            Logger.LogInformation("Processando solicitação de redefinição de senha.");
            var userId = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(_model!.UserId));
            var token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(_model.Token));
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null || !string.Equals(user.Email, _model.Email.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                _message = "Este link de redefinição é inválido ou expirou.";
                _tokenInvalid = true;
                return;
            }

            var result = await UserManager.ResetPasswordAsync(user, token, _model.Password);
            if (result.Succeeded)
            {
                _success = true;
                _message = "Dados validados e senha redefinida com sucesso. Volte à página de login para entrar com sua nova senha.";
                Logger.LogInformation("Redefinição de senha concluída com sucesso para o usuário {UserId}.", user.Id);

                if (!string.IsNullOrWhiteSpace(user.Email))
                {
                    try
                    {
                        await EmailSender.SendAsync(
                            user.Email,
                            "Sua senha WalletFlow foi alterada",
                            "<p>A senha da sua conta WalletFlow foi alterada com sucesso.</p><p>Se você não fez essa alteração, solicite uma nova redefinição de senha.</p>");
                    }
                    catch (Exception exception)
                    {
                        _emailNotificationFailed = true;
                        Logger.LogError(exception, "A senha foi alterada, mas não foi possível enviar o aviso por e-mail.");
                    }
                }
            }
            else
            {
                Logger.LogWarning(
                    "Falha ao redefinir senha para o usuário {UserId}. Códigos retornados pelo Identity: {ErrorCodes}",
                    user.Id,
                    string.Join(", ", result.Errors.Select(error => error.Code)));

                var passwordErrors = GetPasswordPolicyErrors(result.Errors);
                if (passwordErrors.Count > 0)
                {
                    _message = $"A nova senha não atende aos requisitos: {string.Join(" ", passwordErrors)}";
                    return;
                }

                _message = "Este link de redefinição é inválido ou expirou. Solicite outro link.";
                _tokenInvalid = true;
            }
        }
        catch (FormatException)
        {
            _message = "Este link de redefinição é inválido ou expirou.";
            _tokenInvalid = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Erro inesperado ao processar a redefinição de senha.");
            _message = "Não foi possível salvar a nova senha. Atualize a página e tente novamente com um link válido.";
        }
    }

    private static List<string> GetPasswordPolicyErrors(IEnumerable<IdentityError> errors)
    {
        var codes = errors.Select(error => error.Code).ToHashSet(StringComparer.Ordinal);
        var messages = new List<string>();
        if (codes.Contains("PasswordTooShort")) messages.Add("use pelo menos 12 caracteres.");
        if (codes.Contains("PasswordRequiresUniqueChars")) messages.Add("use pelo menos 4 caracteres diferentes.");
        if (codes.Contains("PasswordRequiresUpper")) messages.Add("inclua uma letra maiúscula.");
        if (codes.Contains("PasswordRequiresLower")) messages.Add("inclua uma letra minúscula.");
        if (codes.Contains("PasswordRequiresDigit")) messages.Add("inclua um número.");
        if (codes.Contains("PasswordRequiresNonAlphanumeric")) messages.Add("inclua um símbolo.");
        return messages;
    }

    private sealed class ResetPasswordModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um endereço de e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe uma senha.")]
        [MinLength(12, ErrorMessage = "A senha deve ter pelo menos 12 caracteres.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).+$", ErrorMessage = "Use letra maiúscula, letra minúscula, número e símbolo.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme sua senha.")]
        [Compare(nameof(Password), ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
