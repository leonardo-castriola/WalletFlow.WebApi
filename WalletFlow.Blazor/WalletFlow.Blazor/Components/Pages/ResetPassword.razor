@page "/redefinir-senha"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using WalletFlow.WebApi.Entities
@inject UserManager<WalletUser> UserManager

<PageTitle>Redefinir senha | WalletFlow</PageTitle>

<section class="identity-page">
    <div class="identity-card">
        <a class="identity-brand" href="/">WalletFlow</a>
        <p class="eyebrow">SEGURANÇA DA CONTA</p>
        <h1>Defina uma nova senha</h1>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_success ? "identity-notice" : "identity-error")" role="status">@_message</div>
            @if (_success) { <a class="identity-submit identity-submit-link" href="/">Voltar para entrar</a> }
        }
        else
        {
            <EditForm Model="_model" FormName="reset-password" OnValidSubmit="ResetAsync" Enhance class="identity-form">
                <DataAnnotationsValidator />
                <InputText type="hidden" @bind-Value="_model.UserId" />
                <InputText type="hidden" @bind-Value="_model.Token" />
                <div class="identity-field">
                    <label for="reset-email">E-mail</label>
                    <InputText id="reset-email" class="identity-input" type="email" autocomplete="email" @bind-Value="_model.Email" />
                    <ValidationMessage For="@(() => _model.Email)" />
                </div>
                <div class="identity-field">
                    <label for="reset-password">Nova senha</label>
                    <InputText id="reset-password" class="identity-input" type="password" autocomplete="new-password" @bind-Value="_model.Password" />
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>
                <div class="identity-field">
                    <label for="reset-confirm-password">Confirmar nova senha</label>
                    <InputText id="reset-confirm-password" class="identity-input" type="password" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>
                <button class="identity-submit" type="submit">Salvar nova senha</button>
            </EditForm>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? QueryUserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? QueryToken { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordModel? _postedModel { get; set; }
    private ResetPasswordModel _model => _postedModel ??= new() { UserId = QueryUserId ?? string.Empty, Token = QueryToken ?? string.Empty };
    private string? _message;
    private bool _success;

    private async Task ResetAsync()
    {
        try
        {
            var userId = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(_model.UserId));
            var token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(_model.Token));
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null || !string.Equals(user.Email, _model.Email.Trim(), StringComparison.OrdinalIgnoreCase))
            {
                _message = "Este link de redefinição é inválido ou expirou.";
                return;
            }

            var result = await UserManager.ResetPasswordAsync(user, token, _model.Password);
            if (result.Succeeded)
            {
                _success = true;
                _message = "Sua senha foi atualizada. Agora você pode entrar.";
            }
            else
                _message = "Este link de redefinição é inválido ou expirou. Solicite outro link.";
        }
        catch (FormatException)
        {
            _message = "Este link de redefinição é inválido ou expirou.";
        }
    }

    private sealed class ResetPasswordModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um endereço de e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe uma senha.")]
        [MinLength(12, ErrorMessage = "A senha deve ter pelo menos 12 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirme sua senha.")]
        [Compare(nameof(Password), ErrorMessage = "As senhas não coincidem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
