@page "/painel"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using WalletFlow.Blazor.DTOs
@using WalletFlow.Blazor.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject TransacaoApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Painel financeiro | WalletFlow</PageTitle>

<div class="dashboard-header">
    <div>
        <p class="eyebrow">CONTROLE FINANCEIRO</p>
        <h1>Bem-vindo ao WalletFlow</h1>
        <p class="text-secondary">Seu dinheiro organizado em um só lugar.</p>
    </div>
    <button class="btn btn-outline-secondary" @onclick="CarregarAsync" disabled="@_carregando">Atualizar</button>
</div>

@if (!string.IsNullOrWhiteSpace(_erro))
{
    <div class="alert alert-danger" role="alert">@_erro</div>
}

<div class="home-grid">
    <section class="balance-card" aria-live="polite">
        <div>
            <p class="balance-label">Saldo consolidado</p>
            <p class="balance-value">@(_saldo?.ToString("C", Cultura) ?? (_carregando ? "Carregando..." : "Indisponível"))</p>
        </div>
        <span class="balance-icon" aria-hidden="true">R$</span>
    </section>

    <section class="panel overview-card">
        <p class="eyebrow">MOVIMENTAÇÕES</p>
        <p class="overview-number">@(_totalTransacoes?.ToString("N0", Cultura) ?? "—")</p>
        <p class="text-secondary">transação(ões) registradas</p>
    </section>
</div>

<p class="chart-order-help">Use as setas em cada gráfico para personalizar a ordem de apresentação.</p>
<div class="charts-grid">
<section class="panel chart-card" style="@OrdemCss("flow")">
        <div class="chart-heading">
            <div><p class="eyebrow">FLUXO DE CAIXA</p><h2>Receitas, despesas e saldo</h2></div>
            <div class="chart-heading-actions"><span class="chart-period">Últimos 6 meses</span>@ControlesOrdem("flow")</div>
        </div>
        @if (_carregando)
        {
            <p class="empty-state" role="status">Carregando gráfico...</p>
        }
        else if (_evolucao is null || _totalTransacoes == 0)
        {
            <p class="empty-state">Cadastre transações para visualizar os gráficos.</p>
        }
        else
        {
            <div class="chart-legend">
                <span><i class="legend-dot income-dot"></i>Receitas</span>
                <span><i class="legend-dot expense-dot"></i>Despesas</span>
                <span><i class="legend-dot balance-dot"></i>Saldo acumulado</span>
            </div>
            <div class="chart-scroll">
                <svg class="finance-chart" viewBox="0 0 720 280" role="img" aria-label="Evolução mensal das receitas, despesas e saldo acumulado">
                    @foreach (var linha in Enumerable.Range(0, 5))
                    {
                        var valor = ValorNoNivelFluxo(linha);
                        var y = YFluxo(valor);
                        <line class="chart-grid-line" x1="82" y1="@SvgNumero(y)" x2="690" y2="@SvgNumero(y)" />
                        @((MarkupString)$"<text class=\"chart-axis-label\" x=\"76\" y=\"{SvgNumero(y + 4)}\" text-anchor=\"end\">{valor.ToString("C0", Cultura)}</text>")
                    }
                    <line class="chart-zero-line" x1="82" y1="@SvgNumero(YFluxo(0m))" x2="690" y2="@SvgNumero(YFluxo(0m))" />
                    <polyline class="chart-line income-line" points="@PontosFluxo(p => p.Receitas)" />
                    <polyline class="chart-line expense-line" points="@PontosFluxo(p => p.Despesas)" />
                    <polyline class="chart-line balance-line" points="@PontosSaldoComparativo()" />
                    @for (var indice = 0; indice < _evolucao.Meses.Count; indice++)
                    {
                        var ponto = _evolucao.Meses[indice];
                        var x = 92 + indice * 118;
                        <g>
                            <circle class="chart-point income-point" cx="@x" cy="@SvgNumero(YFluxo(ponto.Receitas))" r="5">
                                <title>@($"{NomeMes(ponto.Mes)} · Receita: {ponto.Receitas.ToString("C", Cultura)}")</title>
                            </circle>
                            <circle class="chart-point expense-point" cx="@x" cy="@SvgNumero(YFluxo(ponto.Despesas))" r="5">
                                <title>@($"{NomeMes(ponto.Mes)} · Despesa: {ponto.Despesas.ToString("C", Cultura)}")</title>
                            </circle>
                            <circle class="chart-point balance-point" cx="@x" cy="@SvgNumero(YFluxo(ponto.Saldo))" r="5">
                                <title>@($"{NomeMes(ponto.Mes)} · Saldo acumulado: {ponto.Saldo.ToString("C", Cultura)}")</title>
                            </circle>
                            <text class="chart-month-label" x="@x" y="252" text-anchor="middle">@NomeMes(ponto.Mes)</text>
                        </g>
                    }
                </svg>
            </div>
            <p class="chart-note">As três séries usam a mesma escala em reais. O saldo considera o histórico completo da conta.</p>
        }
    </section>

<section class="panel chart-card revenue-pie-card" style="@OrdemCss("revenue")">
        <div class="chart-heading">
            <div><p class="eyebrow">RECEITAS</p><h2>Participação por mês</h2></div>
            <div class="chart-heading-actions"><span class="chart-period">Últimos 6 meses</span>@ControlesOrdem("revenue")</div>
        </div>
        @if (_carregando)
        {
            <p class="empty-state" role="status">Carregando gráfico...</p>
        }
        else if (_evolucao is null || TotalReceitasPeriodo <= 0)
        {
            <p class="empty-state">Não há receitas nos últimos seis meses para exibir.</p>
        }
        else
        {
            <div class="revenue-pie-layout">
                <div class="revenue-pie" style="background: @FatiaReceitasStyle" role="img" aria-label="Gráfico de pizza com a participação das receitas de cada mês nos últimos seis meses"></div>
                <ul class="revenue-pie-legend" aria-label="Receitas por mês">
                    @for (var indice = 0; indice < _evolucao.Meses.Count; indice++)
                    {
                        var ponto = _evolucao.Meses[indice];
                        <li>
                            <span class="pie-legend-name"><i class="pie-swatch" style="background: @CorFatia(indice)"></i>@NomeMes(ponto.Mes)</span>
                            <span class="pie-legend-value">@ponto.Receitas.ToString("C0", Cultura) <small>(@PercentualReceita(ponto.Receitas).ToString("0.#", Cultura)%)</small></span>
                        </li>
                    }
                </ul>
            </div>
        }
    </section>

<section class="panel chart-card" style="@OrdemCss("expenses")">
        <div class="chart-heading">
            <div><p class="eyebrow">DESPESAS</p><h2>Despesas por período</h2></div>
            <div class="chart-heading-actions"><span class="chart-period">Últimos 6 meses</span>@ControlesOrdem("expenses")</div>
        </div>
        @if (_carregando)
        {
            <p class="empty-state" role="status">Carregando gráfico...</p>
        }
        else if (_evolucao is null || _totalTransacoes == 0)
        {
            <p class="empty-state">Cadastre transações para visualizar os gráficos.</p>
        }
        else
        {
            <div class="chart-legend"><span><i class="legend-dot expense-dot"></i>Despesas</span></div>
            <div class="chart-scroll">
                <div class="expense-chart" role="img" aria-label="Despesas mensais nos últimos seis meses">
                    @foreach (var ponto in _evolucao.Meses)
                    {
                        var alturaPercentual = AlturaDespesaPercentual(ponto.Despesas);
                        <div class="expense-column" title="@($"{NomeMes(ponto.Mes)}: {ponto.Despesas.ToString("C", Cultura)} em despesas")">
                            <span class="expense-amount">@ponto.Despesas.ToString("C0", Cultura)</span>
                            <div class="expense-track" aria-hidden="true">
                                <div class="expense-bar" style="height: @($"{alturaPercentual.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
                            </div>
                            <span class="expense-month">@NomeMes(ponto.Mes)</span>
                        </div>
                    }
                </div>
            </div>
            <p class="chart-note">Os valores aparecem acima das barras; a altura é proporcional à maior despesa do período.</p>
        }
    </section>

<section class="panel chart-card balance-area-card" style="@OrdemCss("balance")">
        <div class="chart-heading">
            <div><p class="eyebrow">SALDO</p><h2>Evolução do saldo</h2></div>
            <div class="chart-heading-actions"><span class="chart-period">Últimos 6 meses</span>@ControlesOrdem("balance")</div>
        </div>
        @if (_carregando)
        {
            <p class="empty-state" role="status">Carregando gráfico...</p>
        }
        else if (_evolucao is null || _totalTransacoes == 0)
        {
            <p class="empty-state">Cadastre transações para visualizar a evolução do saldo.</p>
        }
        else
        {
            <div class="chart-legend"><span><i class="legend-dot balance-dot"></i>Saldo acumulado</span></div>
            <div class="chart-scroll">
                <svg class="finance-chart" viewBox="0 0 720 280" role="img" aria-label="Gráfico de área da evolução mensal do saldo acumulado">
                    @foreach (var linha in Enumerable.Range(0, 5))
                    {
                        var y = YSaldo(SaldoNoNivel(linha));
                        <line class="chart-grid-line" x1="82" y1="@SvgNumero(y)" x2="690" y2="@SvgNumero(y)" />
                    }
                    @for (var nivel = 0; nivel < 5; nivel++)
                    {
                        var y = YSaldo(SaldoNoNivel(nivel));
                        @((MarkupString)$"<text class=\"chart-axis-label\" x=\"76\" y=\"{SvgNumero(y + 4)}\" text-anchor=\"end\">{SaldoNoNivel(nivel).ToString("C0", Cultura)}</text>")
                    }
                    <polygon class="balance-area" points="@PontosAreaSaldo()" />
                    <line class="chart-zero-line" x1="82" y1="@SvgNumero(YSaldo(0m))" x2="690" y2="@SvgNumero(YSaldo(0m))" />
                    <polyline class="chart-line balance-area-line" points="@PontosSaldo()" />
                    @for (var indice = 0; indice < _evolucao.Meses.Count; indice++)
                    {
                        var ponto = _evolucao.Meses[indice];
                        var x = 92 + indice * 118;
                        <g>
                            <title>@($"{NomeMes(ponto.Mes)}: saldo {ponto.Saldo.ToString("C", Cultura)}")</title>
                            <circle class="chart-point balance-point" cx="@x" cy="@SvgNumero(YSaldo(ponto.Saldo))" r="5" />
                            <text class="chart-month-label" x="@x" y="252" text-anchor="middle">@NomeMes(ponto.Mes)</text>
                        </g>
                    }
                </svg>
            </div>
            <p class="chart-note">Valores em reais. O saldo mensal considera o histórico completo da conta; passe sobre um ponto para ver o valor exato.</p>
        }
    </section>
</div>

<section class="panel transactions-panel dashboard-transactions">
    <div class="section-heading">
        <div><p class="eyebrow">ATIVIDADE RECENTE</p><h2>Últimas transações</h2></div>
        <button class="btn btn-link" @onclick='() => Navigation.NavigateTo("/transacoes")'>Ver extrato completo</button>
    </div>

    @if (_carregando)
    {
        <p class="empty-state" role="status">Carregando movimentações...</p>
    }
    else if (_transacoesRecentes.Count == 0)
    {
        <p class="empty-state">Ainda não há transações cadastradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table transaction-table align-middle">
                <thead><tr><th>Descrição</th><th>Data</th><th>Tipo</th><th class="text-end">Valor</th></tr></thead>
                <tbody>
                    @foreach (var transacao in _transacoesRecentes)
                    {
                        <tr>
                            <td class="transaction-description">@transacao.Descricao</td>
                            <td>@transacao.DataCadastro.ToLocalTime().ToString("dd/MM/yyyy", Cultura)</td>
                            <td><span class="type-pill @(transacao.TipoFormatado == "Receita" ? "income" : "expense")">@transacao.TipoFormatado</span></td>
                            <td class="text-end transaction-value">@transacao.Valor.ToString("C", Cultura)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel welcome-panel">
    <div>
        <p class="eyebrow">COMECE POR AQUI</p>
        <h2>O que você deseja fazer?</h2>
        <p class="text-secondary">Registre uma movimentação ou consulte seu extrato com filtros por período e tipo.</p>
    </div>
    <div class="quick-actions">
        <button class="btn btn-primary" @onclick='() => Navigation.NavigateTo("/transacoes/nova")'>＋ Nova transação</button>
        <button class="btn btn-outline-primary" @onclick='() => Navigation.NavigateTo("/transacoes")'>Ver extrato</button>
    </div>
</section>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private static readonly string[] CoresFatia = ["#2463eb", "#0f9f6e", "#f59e0b", "#8b5cf6", "#e34f65", "#0891b2"];
    private decimal? _saldo;
    private int? _totalTransacoes;
    private IReadOnlyList<TransacaoRespostaDto> _transacoesRecentes = [];
    private EvolucaoFinanceiraDto? _evolucao;
    private bool _carregando = true;
    private string? _erro;
    private string? _usuarioId;
    private IJSObjectReference? _dashboardModule;
    private List<string> _ordemGraficos = ["flow", "revenue", "expenses", "balance"];
    private static readonly string[] GraficosValidos = ["flow", "revenue", "expenses", "balance"];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _usuarioId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(_usuarioId))
        {
            _erro = "Não foi possível identificar a sessão autenticada.";
            _carregando = false;
            return;
        }

        // O cliente de API envia este NameIdentifier pelo canal servidor-a-servidor;
        // a API valida a conta e usa o claim para filtrar todas as consultas.
        await CarregarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dashboardModule = await JS.InvokeAsync<IJSObjectReference>("import", "./dashboard.js");
            var salva = await _dashboardModule.InvokeAsync<string[]>("loadChartOrder");
            if (salva.Length == GraficosValidos.Length && salva.Distinct().Count() == GraficosValidos.Length && salva.All(GraficosValidos.Contains))
                _ordemGraficos = salva.ToList();
            StateHasChanged();
        }
        catch (JSException)
        {
            // Se o armazenamento do navegador não estiver disponível, usa a ordem padrão.
        }
    }

    private string OrdemCss(string grafico) => $"order: {_ordemGraficos.IndexOf(grafico)};";

    private RenderFragment ControlesOrdem(string grafico) => @<div class="chart-order-controls" role="group" aria-label="Reordenar gráfico">
        <button type="button" class="chart-order-button" @onclick="() => MoverGraficoAsync(grafico, -1)" disabled="@(_ordemGraficos.IndexOf(grafico) == 0)" aria-label="Mover @NomeGrafico(grafico) para cima" title="Mover para cima">↑</button>
        <button type="button" class="chart-order-button" @onclick="() => MoverGraficoAsync(grafico, 1)" disabled="@(_ordemGraficos.IndexOf(grafico) == _ordemGraficos.Count - 1)" aria-label="Mover @NomeGrafico(grafico) para baixo" title="Mover para baixo">↓</button>
    </div>;

    private static string NomeGrafico(string grafico) => grafico switch
    {
        "flow" => "Receitas, despesas e saldo",
        "revenue" => "Receitas",
        "expenses" => "Despesas",
        "balance" => "Saldo",
        _ => "gráfico"
    };

    private async Task MoverGraficoAsync(string grafico, int deslocamento)
    {
        var indice = _ordemGraficos.IndexOf(grafico);
        var novoIndice = indice + deslocamento;
        if (indice < 0 || novoIndice < 0 || novoIndice >= _ordemGraficos.Count) return;
        (_ordemGraficos[indice], _ordemGraficos[novoIndice]) = (_ordemGraficos[novoIndice], _ordemGraficos[indice]);
        if (_dashboardModule is not null)
            await _dashboardModule.InvokeVoidAsync("saveChartOrder", _ordemGraficos);
    }

    public async ValueTask DisposeAsync()
    {
        if (_dashboardModule is null) return;
        try { await _dashboardModule.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        _erro = null;
        try
        {
            var saldoTask = Api.ObterSaldoAsync();
            var extratoTask = Api.ObterTransacoesAsync(1, 5, null, null, null);
            var evolucaoTask = Api.ObterEvolucaoMensalAsync();
            await Task.WhenAll(saldoTask, extratoTask, evolucaoTask);
            _saldo = await saldoTask;
            var extrato = await extratoTask;
            _evolucao = await evolucaoTask;
            _totalTransacoes = extrato.TotalCount;
            _transacoesRecentes = extrato.Items;
        }
        catch (HttpRequestException ex)
        {
            _erro = ex.StatusCode is null
                ? "Não foi possível conectar à API. Confira se ela está em execução e se Api:BaseUrl está correto."
                : ex.Message;
        }
        finally
        {
            _carregando = false;
        }
    }

    private decimal MinimoFluxo => Math.Min(0m, _evolucao?.Meses.SelectMany(ponto => new[] { ponto.Receitas, ponto.Despesas, ponto.Saldo }).DefaultIfEmpty(0m).Min() ?? 0m);
    private decimal MaximoFluxo => Math.Max(0m, _evolucao?.Meses.SelectMany(ponto => new[] { ponto.Receitas, ponto.Despesas, ponto.Saldo }).DefaultIfEmpty(0m).Max() ?? 0m);
    private decimal MaximoDespesa => _evolucao?.Meses.Select(ponto => ponto.Despesas).DefaultIfEmpty(0m).Max() ?? 0m;
    private decimal TotalReceitasPeriodo => _evolucao?.Meses.Sum(ponto => ponto.Receitas) ?? 0m;
    private double PercentualReceita(decimal valor) => TotalReceitasPeriodo <= 0 ? 0 : (double)(valor / TotalReceitasPeriodo) * 100d;
    private string CorFatia(int indice) => CoresFatia[indice % CoresFatia.Length];
    private string FatiaReceitasStyle
    {
        get
        {
            var acumulado = 0d;
            var faixas = new List<string>();
            for (var indice = 0; indice < _evolucao!.Meses.Count; indice++)
            {
                var inicio = acumulado;
                acumulado += PercentualReceita(_evolucao.Meses[indice].Receitas);
                faixas.Add($"{CorFatia(indice)} {SvgNumero(inicio)}% {SvgNumero(acumulado)}%");
            }

            return $"conic-gradient({string.Join(", ", faixas)})";
        }
    }
    private double AlturaDespesaPercentual(decimal valor) => MaximoDespesa <= 0 ? 0 : (double)(valor / MaximoDespesa) * 100d;
    private double YFluxo(decimal valor)
    {
        var intervalo = MaximoFluxo - MinimoFluxo;
        return intervalo == 0 ? 134 : 224 - (double)((valor - MinimoFluxo) / intervalo) * 180;
    }
    private decimal ValorNoNivelFluxo(int nivel) => MaximoFluxo - (MaximoFluxo - MinimoFluxo) * nivel / 4m;
    private double YSaldo(decimal valor)
    {
        var saldos = _evolucao?.Meses.Select(ponto => ponto.Saldo).ToArray() ?? [];
        if (saldos.Length == 0) return 126;
        var minimo = Math.Min(0m, saldos.Min());
        var maximo = Math.Max(0m, saldos.Max());
        var intervalo = maximo - minimo;
        return intervalo == 0 ? 126 : 224 - (double)((valor - minimo) / intervalo) * 180;
    }
    private decimal SaldoNoNivel(int nivel)
    {
        var saldos = _evolucao?.Meses.Select(ponto => ponto.Saldo).ToArray() ?? [];
        if (saldos.Length == 0) return 0m;
        var minimo = Math.Min(0m, saldos.Min());
        var maximo = Math.Max(0m, saldos.Max());
        return maximo - (maximo - minimo) * nivel / 4m;
    }
    private string PontosFluxo(Func<PontoEvolucaoFinanceiraDto, decimal> seletor) =>
        string.Join(" ", _evolucao!.Meses.Select((ponto, indice) => $"{92 + indice * 118},{YFluxo(seletor(ponto)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}"));
    private string PontosSaldoComparativo() =>
        string.Join(" ", _evolucao!.Meses.Select((ponto, indice) => $"{92 + indice * 118},{SvgNumero(YFluxo(ponto.Saldo))}"));
    private string PontosSaldo() =>
        string.Join(" ", _evolucao!.Meses.Select((ponto, indice) => $"{92 + indice * 118},{YSaldo(ponto.Saldo).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}"));
    private string PontosAreaSaldo()
    {
        var pontos = _evolucao!.Meses.Select((ponto, indice) => $"{92 + indice * 118},{SvgNumero(YSaldo(ponto.Saldo))}").ToList();
        if (pontos.Count == 0) return string.Empty;
        var linhaZero = SvgNumero(YSaldo(0m));
        return $"92,{linhaZero} {string.Join(" ", pontos)} {92 + (pontos.Count - 1) * 118},{linhaZero}";
    }
    private static string SvgNumero(double valor) => valor.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string NomeMes(DateOnly mes) => mes.ToString("MMM", Cultura).TrimEnd('.');
}
