@page "/esqueci-a-senha"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using WalletFlow.Blazor.Services
@using WalletFlow.WebApi.Entities
@using WalletFlow.WebApi.Services
@inject UserManager<WalletUser> UserManager
@inject IEmailSender EmailSender
@inject IConfiguration Configuration
@inject IHostEnvironment HostEnvironment
@inject NavigationManager Navigation
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar senha | WalletFlow</PageTitle>

<section class="identity-page" aria-labelledby="forgot-password-title">
    <div class="identity-card">
        <a class="identity-brand" href="/" aria-label="WalletFlow — página inicial">
            <span class="identity-brand-mark" aria-hidden="true">W</span>
            <span>WalletFlow</span>
        </a>

        <header class="identity-heading">
            <p class="eyebrow">RECUPERAÇÃO DE ACESSO</p>
            <h1 id="forgot-password-title">Esqueceu sua senha?</h1>
            <p class="identity-intro">Informe o e-mail da sua conta. Se encontrarmos uma conta confirmada, enviaremos um link para redefinição.</p>
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="identity-notice" role="status">@_message</div>
        }
        else
        {
            <EditForm Model="_model!" FormName="forgot-password" OnValidSubmit="SendResetLinkAsync" Enhance class="identity-form">
                <DataAnnotationsValidator />
                <div class="identity-field">
                    <label for="forgot-email">E-mail</label>
                    <InputText id="forgot-email" class="identity-input" type="email" autocomplete="email" @bind-Value="_model!.Email" />
                    <ValidationMessage For="@(() => _model!.Email)" />
                </div>
                <button class="identity-submit" type="submit">Enviar link de recuperação</button>
            </EditForm>
        }
        <p class="identity-footer"><a href="/">Voltar para entrar</a></p>
        <p class="identity-security-note"><span aria-hidden="true">●</span> Seus dados são tratados com segurança.</p>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotPasswordModel? _model { get; set; }
    private string? _message;

    protected override void OnInitialized() => _model ??= new();

    private async Task SendResetLinkAsync()
    {
        var user = await UserManager.FindByEmailAsync(_model!.Email.Trim());
        if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
        {
            try
            {
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                var link = IdentityLinkBuilder.Build("redefinir-senha", user.Id, token, Configuration, HostEnvironment, Navigation);
                var safeLink = HtmlEncoder.Default.Encode(link);
                await EmailSender.SendAsync(user.Email!, "Redefina sua senha WalletFlow",
                    $"<p>Recebemos uma solicitação para redefinir sua senha. <a href=\"{safeLink}\">Crie uma nova senha neste link</a>.</p><p>Se você não solicitou isso, ignore esta mensagem.</p>");
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Falha ao enviar um link de redefinição de senha.");
            }
        }

        // A mesma resposta impede a descoberta de quais endereços possuem conta.
        _message = "Se houver uma conta confirmada para esse endereço, enviaremos as instruções em breve.";
    }

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um endereço de e-mail válido.")]
        public string Email { get; set; } = string.Empty;
    }
}
