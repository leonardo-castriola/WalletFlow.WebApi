@page "/"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using WalletFlow.WebApi.Entities
@inject SignInManager<WalletUser> SignInManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Entrar | WalletFlow</PageTitle>

<section class="login-page" aria-labelledby="login-title">
    <div class="login-card">
        <a class="login-brand" href="/" aria-label="WalletFlow — página inicial">
            <span class="login-brand-mark" aria-hidden="true">W</span>
            <span>WalletFlow</span>
        </a>

        <header class="login-heading">
            <p class="login-eyebrow">BEM-VINDO DE VOLTA</p>
            <h1 id="login-title">Acesse sua conta</h1>
            <p>Entre para acompanhar suas finanças com tranquilidade.</p>
        </header>

        <EditForm Model="_model!" FormName="login" OnValidSubmit="HandleLogin" Enhance class="login-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="login-validation-summary" />

            <div class="login-field">
                <label for="login-email">E-mail</label>
                <InputText id="login-email"
                           class="login-input"
                           type="email"
                           autocomplete="email"
                           placeholder="voce@exemplo.com"
                           @bind-Value="_model!.Email" />
                <ValidationMessage For="@(() => _model!.Email)" class="login-field-error" />
            </div>

            <div class="login-field">
                <div class="login-label-row">
                    <label for="login-password">Senha</label>
                    <a class="login-forgot-link" href="esqueci-a-senha">Esqueceu a senha?</a>
                </div>
                <div class="login-password-wrap">
                    <InputText id="login-password"
                               class="login-input"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Digite sua senha"
                               @bind-Value="_model!.Password" />
                    <button class="login-password-toggle" type="button" data-password-toggle aria-controls="login-password" aria-label="Mostrar senha" aria-pressed="false">
                        <svg class="password-eye" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2.5 12s3.45-6 9.5-6 9.5 6 9.5 6-3.45 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="2.7" stroke="currentColor" stroke-width="1.7"/></svg>
                        <svg class="password-eye-off" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.05 0 9.5 7 9.5 7a15 15 0 0 1-3.1 3.9M6.2 6.2C3.8 7.8 2.5 12 2.5 12s3.45 7 9.5 7c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <ValidationMessage For="@(() => _model!.Password)" class="login-field-error" />
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <p class="login-placeholder-message" role="status">@_message</p>
            }

            <button class="login-submit" type="submit">Entrar</button>
        </EditForm>

        <p class="login-signup">
            Ainda não tem uma conta? <a href="criar-conta">Criar uma conta</a>
        </p>

        <p class="login-security-note"><span aria-hidden="true">●</span> Seus dados são tratados com segurança.</p>
    </div>
</section>

@code {
    [SupplyParameterFromForm(FormName = "login")]
    private LoginModel? _model { get; set; }
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _model ??= new();
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/painel", forceLoad: true);
    }

    private async Task HandleLogin()
    {
        var model = _model!;
        var result = await SignInManager.PasswordSignInAsync(
            model.Email, model.Password, isPersistent: false, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo("/painel", forceLoad: true);
            return;
        }

        _message = result.IsLockedOut
            ? "Muitas tentativas. Aguarde alguns minutos antes de tentar novamente."
            : "E-mail ou senha inválidos.";
        model.Password = string.Empty;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um endereço de e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe sua senha.")]
        public string Password { get; set; } = string.Empty;
    }
}
