# Copie este arquivo para .env e preencha com os segredos reais de produção.
# Execute ./scripts/preflight-check.sh antes do deploy para garantir que nenhum placeholder permaneceu.
# Nunca versione o arquivo .env com credenciais reais.

# Domínios públicos HTTPS (usados pelo Caddy para TLS e como AllowedHosts explícitos)
BLAZOR_DOMAIN=walletflow.exemplo.com
API_DOMAIN=api.walletflow.exemplo.com

# Segredos compartilhados entre Blazor e API
AUTHENTICATION_API_KEY=substitua-por-uma-chave-de-servico-forte-aleatoria
AUTHENTICATION_JWT_SIGNING_KEY=substitua-por-um-segredo-jwt-com-pelo-menos-32-bytes
AUTHENTICATION_JWT_ISSUER=WalletFlow
AUTHENTICATION_JWT_AUDIENCE=WalletFlow.Api

# Confirmação obrigatória de e-mail no cadastro público em produção
IDENTITY_REQUIRE_CONFIRMED_EMAIL=true

# Criptografia AES-256 e diretórios de backup (local + cópia externa fora do host/volume)
BACKUP_ENCRYPTION_KEY=substitua-por-uma-chave-de-criptografia-de-backup-forte
BACKUP_HOST_PATH=./backups
BACKUP_OFFSITE_PATH=./backups-offsite
BACKUP_OFFSITE_CMD=
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

# Configuração SMTP para confirmação de conta, recuperação de senha, envio de extrato em PDF e alertas
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_IMPLICIT_TLS=false
EMAIL_SMTP_USERNAME=seu-email@dominio.com
EMAIL_SMTP_PASSWORD=sua-senha-de-aplicativo
EMAIL_SMTP_FROM=seu-email@dominio.com

# Relatórios mensais e fuso horário
REPORTS_MONTHLY_ENABLED=true
TIMEZONE_ID=America/Sao_Paulo
