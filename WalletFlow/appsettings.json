{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "WalletFlow",
      "Audience": "WalletFlow.Api"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Wallet.db"
  },
  "Reports": {
    "Monthly": {
      "Enabled": false,
      "Day": 1,
      "Hour": 8,
      "Minute": 0,
      "PollIntervalMinutes": 60,
      "TimeZoneId": "America/Sao_Paulo"
    }
  }
}
