<Project>
  <PropertyGroup>
    <!-- Evita aviso NU1900 quando o build/restore executa em ambientes isolados sem internet -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <!-- Desativa a geracao do apphost.exe para evitar bloqueio (UnauthorizedAccessException) pelo OneDrive/Antivirus -->
    <UseAppHost>false</UseAppHost>
    <Authors>Leonardo Castriola</Authors>
    <Copyright>Copyright (c) 2026 Leonardo Castriola. Todos os direitos reservados.</Copyright>
  </PropertyGroup>
</Project>
